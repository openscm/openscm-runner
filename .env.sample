# Environment variables that can be useful in this work

# How the MAGICC AR6 tests (and acceptance data scripts) get
# MAGICC v7.5.3 and the AR6 probabilistic distribution.
# Either point at copies you already have (if both are set, these are used)
MAGICC_AR6_V753_ROOT_DIR=
MAGICC_AR6_PROBABILISTIC_DISTRIBUTION=
# or give a magicc.org download token
# (log in at https://magicc.org/download/magicc7 to get one)
# to download the official versions (into the operating system's cache, once).
MAGICC_AR6_DOWNLOAD_TOKEN=
